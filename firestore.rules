rules_version = '2';
// Waihona — the entire server-side security boundary.
// Tested by tests/rules.test.mjs against the Firestore emulator (CI `rules` job).
// Governance is transparent: roles and the merged-content overlay are public reads.
service cloud.firestore {
  match /databases/{db}/documents {

    function signedIn() { return request.auth != null; }
    function roles() { return get(/databases/$(db)/documents/meta/roles).data; }
    // Superadmin = the project admin (GOVERNANCE.md). The list is only ever
    // edited by hand in the Firebase console — no rule below allows writing it.
    function isSuperadmin() {
      return signedIn() && request.auth.uid in roles().get('superadmins', []);
    }
    function isAdmin() {
      return isSuperadmin()
          || (signedIn() && request.auth.uid in roles().get('admins', []));
    }
    function maintains(rm) {
      return signedIn() && rm in roles().maintainers
          && roles().maintainers[rm].uid == request.auth.uid;
    }
    function moderates(rm) { return isAdmin() || maintains(rm); }

    // ---- structural-op grammar, shared by proposals and merged docs ----
    // One vocabulary for every change to a map:
    //   edit   {file, topic}                  rewrite one core topic
    //   add    {file, topic, after}           new core topic ("" = at the top)
    //   remove {file}                         delete a core topic
    //   spine  {spine: [files…]}              reorder core topics
    //   move   {file, topic, file2, topic2}   subtopic moved between topics
    // Docs without `kind` are legacy edits. Entry-level checks the rules
    // language can't express (spine entries, topic internals) are re-validated
    // by tools/land.mjs + build.py before anything reaches the repo.
    function validFile(f) {
      return f is string && f.matches('[0-9][0-9]-[a-z0-9-]+\\.json');
    }
    function validTopic(t) {
      return t is map && t.keys().hasAll(['id','title','tier','learn','do']);
    }
    function opKind(d) { return ('kind' in d) ? d.kind : 'edit'; }
    function validStructOp(d) {
      return (opKind(d) == 'edit'   && validFile(d.file) && validTopic(d.topic))
          || (opKind(d) == 'add'    && validFile(d.file) && validTopic(d.topic)
                                    && (d.after == '' || validFile(d.after)))
          || (opKind(d) == 'remove' && validFile(d.file))
          || (opKind(d) == 'spine'  && d.spine is list
                                    && d.spine.size() >= 2 && d.spine.size() <= 60)
          || (opKind(d) == 'move'   && validFile(d.file) && validFile(d.file2)
                                    && d.file != d.file2
                                    && validTopic(d.topic) && validTopic(d.topic2));
    }

    // Who tends which map. Bootstrapped ONCE by hand in the Firebase console;
    // rules never allow create — "allow create when missing" would be a race
    // anyone with the project id could win. Escalation ladder: admins bind
    // maintainers; the superadmin binds admins; `superadmins` itself is
    // immutable to every client (console-only), so a compromised admin or
    // superadmin account can never mint new root.
    match /meta/roles {
      allow read: if true;
      allow update: if (isSuperadmin()
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['maintainers','admins']))
        || (isAdmin()
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['maintainers']));
      allow create, delete: if false;
    }

    // Each user's progress/notes blob. 1 MiB doc limit is Firestore-native.
    match /users/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    // Approved community tips, shown under nodes. Public read.
    match /tips/{rm} {
      allow read: if true;
      allow write: if moderates(rm);
    }

    match /suggestions/{id} {
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(
             ['roadmap','node','nodeTitle','type','text','url','verified','by','createdAt','status'])
        && request.resource.data.by.uid == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.type in ['fix','link','tip','topic','roadmap']
        && request.resource.data.text is string
        && request.resource.data.text.size() >= 20
        && request.resource.data.text.size() <= 4000
        && request.resource.data.url is string
        && request.resource.data.url.size() <= 500
        && (request.resource.data.url == '' || request.resource.data.url.matches('https://.*'))
        && request.resource.data.roadmap is string
        && request.resource.data.roadmap.size() <= 50
        && request.resource.data.node is string
        && request.resource.data.node.size() <= 80
        && request.resource.data.nodeTitle.size() <= 120
        && request.resource.data.createdAt == request.time;
      allow read: if isAdmin() || maintains(resource.data.roadmap);
      allow update: if moderates(resource.data.roadmap)
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['status','decidedAt','decidedBy'])
        && request.resource.data.status in ['published','accepted','rejected'];
      allow delete: if isAdmin();
    }

    match /proposals/{id} {
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(
             ['roadmap','kind','file','file2','baseHash','baseHash2','topic','topic2',
              'after','spine','note','by','createdAt','status'])
        && request.resource.data.by.uid == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.roadmap.matches('[a-z0-9-]{1,50}')
        && validStructOp(request.resource.data)
        && request.resource.data.note is string
        && request.resource.data.note.size() <= 1000
        && request.resource.data.createdAt == request.time;
      allow read: if isAdmin() || maintains(resource.data.roadmap);
      allow update: if moderates(resource.data.roadmap)
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['status','decidedAt','decidedBy'])
        && request.resource.data.status in ['merged','rejected'];
      allow delete: if isAdmin();
    }

    // Merged edits: the live content overlay (public read) AND the landing
    // queue for the GitHub Action. The Action uses the Admin SDK (bypasses
    // rules) to stamp committedSha / clean up.
    match /merged/{id} {
      allow read: if true;
      allow create: if moderates(request.resource.data.roadmap)
        && request.resource.data.mergedBy.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(
             ['roadmap','kind','file','file2','topic','topic2','after','spine',
              'by','mergedBy','note','at'])
        && request.resource.data.roadmap.matches('[a-z0-9-]{1,50}')
        && validStructOp(request.resource.data);
      allow update, delete: if false;
    }

    // Collections: owner-curated shelves of existing maps (GOVERNANCE.md's
    // "fork valve"). Pointers, not content — they can't touch topic files, so
    // no review pipeline: the owner IS the filter. Admins moderate with
    // exactly two switches (featured / hidden). `maps` entries can't be
    // iterated by the rules language; the client renders only ids it finds in
    // the index, so junk entries are inert.
    function validCollection(d) {
      return d.keys().hasOnly(['title','blurb','maps','owner',
                               'featured','hidden','createdAt','updatedAt'])
        && d.title is string && d.title.size() >= 3 && d.title.size() <= 60
        && d.blurb is string && d.blurb.size() <= 300
        && d.maps is list && d.maps.size() >= 1 && d.maps.size() <= 30
        && d.owner is map
        && d.owner.uid is string && d.owner.uid.size() <= 128
        && d.owner.name is string && d.owner.name.size() <= 80
        && d.featured is bool && d.hidden is bool;
    }
    // Personal versions ("Personalize"): a fork is NOT a copy — it's the base
    // map's id plus a saved list of structural ops, rendered client-side over
    // the live base by the same applyMergedDocs used for the merged overlay.
    // Untouched topics therefore track the canonical map automatically; only
    // op-covered topics diverge. Ops can't be iterated by the rules language
    // (same caveat as collection `maps` / spine entries): the client validates
    // and escapes on render, and forks never reach the repo pipeline, so a
    // malformed op can only garble its own fork. Admin moderation = `hidden`.
    function validFork(d) {
      return d.keys().hasOnly(['base','title','ops','owner',
                               'hidden','createdAt','updatedAt'])
        && d.base is string && d.base.matches('[a-z0-9-]{1,50}')
        && d.title is string && d.title.size() >= 3 && d.title.size() <= 80
        && d.ops is list && d.ops.size() <= 100
        && d.owner is map
        && d.owner.uid is string && d.owner.uid.size() <= 128
        && d.owner.name is string && d.owner.name.size() <= 80
        && d.hidden is bool;
    }
    match /forks/{id} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.owner.uid == request.auth.uid
        && validFork(request.resource.data)
        && request.resource.data.hidden == false
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow update: if (signedIn()
          && resource.data.owner.uid == request.auth.uid
          && validFork(request.resource.data)
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['title','ops','updatedAt']))
        || (isAdmin()
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['hidden']));
      allow delete: if isAdmin()
        || (signedIn() && resource.data.owner.uid == request.auth.uid);
    }

    match /collections/{id} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.owner.uid == request.auth.uid
        && validCollection(request.resource.data)
        && request.resource.data.featured == false
        && request.resource.data.hidden == false
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow update: if (signedIn()
          && resource.data.owner.uid == request.auth.uid
          && validCollection(request.resource.data)
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['title','blurb','maps','updatedAt']))
        || (isAdmin()
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['featured','hidden']));
      allow delete: if isAdmin()
        || (signedIn() && resource.data.owner.uid == request.auth.uid);
    }
  }
}
