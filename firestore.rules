rules_version = '2';
// Waihona — the entire server-side security boundary.
// Tested by tests/rules.test.mjs against the Firestore emulator (CI `rules` job).
// Governance is transparent: roles and the merged-content overlay are public reads.
service cloud.firestore {
  match /databases/{db}/documents {

    function signedIn() { return request.auth != null; }
    function roles() { return get(/databases/$(db)/documents/meta/roles).data; }
    // Superadmin = the project admin (GOVERNANCE.md). The list is only ever
    // edited by hand in the Firebase console — no rule below allows writing it.
    function isSuperadmin() {
      return signedIn() && request.auth.uid in roles().get('superadmins', []);
    }
    function isAdmin() {
      return isSuperadmin()
          || (signedIn() && request.auth.uid in roles().get('admins', []));
    }
    function maintains(rm) {
      return signedIn() && rm in roles().maintainers
          && roles().maintainers[rm].uid == request.auth.uid;
    }
    function moderates(rm) { return isAdmin() || maintains(rm); }
    // The AI agent corps files pre-drafted proposals via the Admin SDK under
    // by.uid `agent:*` — a namespace no Firebase Auth uid can occupy. Belt and
    // braces: no CLIENT may ever write as an agent (by.uid == auth.uid already
    // blocks it; this keeps the invariant explicit and tested). Agents hold no
    // role above Walker: nothing anywhere lets an agent merge.
    function notAgentIdentity(d) { return !d.by.uid.matches('agent:.*'); }
    // Stewards: trusted contributors deputized BY a maintainer FOR that
    // maintainer's map. They may merge trivial edits only (see the weight
    // rules on /proposals and /merged) — never structural changes. Bindings
    // live per-map in /stewards/{rm} so a maintainer's write authority never
    // reaches past their own map.
    function stewardOf(rm) {
      return signedIn()
        && exists(/databases/$(db)/documents/stewards/$(rm))
        && request.auth.uid in get(/databases/$(db)/documents/stewards/$(rm)).data.members;
    }
    // Guides: subject-area coordinators, elected per guild eventually —
    // admin-appointed until an electorate exists (the spec's own Phase 1→2
    // line). Janitorial and social authority, explicitly NOT editorial:
    // guides moderate guild talk, flag orphans, and manage endorsements.
    // They can never merge content.
    function guideOf(gid) {
      return signedIn()
        && exists(/databases/$(db)/documents/guilds/$(gid))
        && request.auth.uid in get(/databases/$(db)/documents/guilds/$(gid)).data.guides;
    }

    // ---- structural-op grammar, shared by proposals and merged docs ----
    // One vocabulary for every change to a map:
    //   edit   {file, topic}                  rewrite one core topic
    //   add    {file, topic, after}           new core topic ("" = at the top)
    //   remove {file}                         delete a core topic
    //   spine  {spine: [files…]}              reorder core topics
    //   move   {file, topic, file2, topic2}   subtopic moved between topics
    //   about  {about}                        the category page's lead prose
    // Docs without `kind` are legacy edits. Entry-level checks the rules
    // language can't express (spine entries, topic internals) are re-validated
    // by tools/land.mjs + build.py before anything reaches the repo.
    function validFile(f) {
      return f is string && f.matches('[0-9][0-9]-[a-z0-9-]+\\.json');
    }
    function validTopic(t) {
      return t is map && t.keys().hasAll(['id','title','tier','learn','do']);
    }
    function opKind(d) { return ('kind' in d) ? d.kind : 'edit'; }
    // ---- proposal weight classes (Part IV of the project structure) ----
    // spine/add/remove/move reshape the map: always structural. An `edit` is
    // trivial or substantive by the proposer's declaration (`weight`), checked
    // by the reviewing human — the review card recomputes and flags mismatch.
    // Absent weight = substantive (every pre-weight doc keeps full gravity).
    function structuralKind(d) { return opKind(d) in ['add','remove','spine','move']; }
    function trivialEdit(d) { return opKind(d) == 'edit' && d.get('weight','substantive') == 'trivial'; }
    function validStructOp(d) {
      return (opKind(d) == 'edit'   && validFile(d.file) && validTopic(d.topic))
          || (opKind(d) == 'add'    && validFile(d.file) && validTopic(d.topic)
                                    && (d.after == '' || validFile(d.after)))
          || (opKind(d) == 'remove' && validFile(d.file))
          || (opKind(d) == 'spine'  && d.spine is list
                                    && d.spine.size() >= 2 && d.spine.size() <= 60)
          || (opKind(d) == 'move'   && validFile(d.file) && validFile(d.file2)
                                    && d.file != d.file2
                                    && validTopic(d.topic) && validTopic(d.topic2))
          || (opKind(d) == 'about'  && d.about is string
                                    && d.about.size() >= 20 && d.about.size() <= 4000);
    }

    // Who tends which map. Bootstrapped ONCE by hand in the Firebase console;
    // rules never allow create — "allow create when missing" would be a race
    // anyone with the project id could win. Escalation ladder: admins bind
    // maintainers; the superadmin binds admins; `superadmins` itself is
    // immutable to every client (console-only), so a compromised admin or
    // superadmin account can never mint new root.
    match /meta/roles {
      allow read: if true;
      allow update: if (isSuperadmin()
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['maintainers','admins']))
        || (isAdmin()
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['maintainers']));
      allow create, delete: if false;
    }

    // The thanks record: who has supported the project, admin-bound after a
    // donation arrives (v1 is manual — no webhooks). members: {uid: 'YYYY-MM-DD'}.
    // Public read mirrors roles — patronage is transparent — but the mark
    // carries no authority: no rule anywhere consults this doc.
    match /meta/supporters {
      allow read: if true;
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasOnly(['members'])
        && request.resource.data.members is map;
      allow delete: if false;
    }

    // Each user's progress/notes blob. 1 MiB doc limit is Firestore-native.
    match /users/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;

      // The journal: dated entries + reflections, one doc per entry — long-form
      // writing must never ride inside the 1 MiB users blob. Owner-only in
      // both directions; deletion is a tombstone doc (deleted:true, text
      // cleared) so cross-device sync erases everywhere.
      match /journal/{entryId} {
        allow read, delete: if signedIn() && request.auth.uid == uid;
        allow create, update: if signedIn() && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(
               ['rm','node','kind','prompt','date','text','createdAt','updatedAt','deleted'])
          && request.resource.data.kind in ['entry','reflection']
          && request.resource.data.rm is string
          && request.resource.data.rm.size() <= 50
          && request.resource.data.text is string
          && request.resource.data.text.size() <= 10000
          && request.resource.data.get('prompt', '') is string
          && request.resource.data.get('prompt', '').size() <= 500
          && request.resource.data.date is string
          && request.resource.data.date.size() <= 10;
      }
    }

    // Map lifecycle overlay, one doc per map — the states that change WITHOUT
    // a repo commit. Static states (draft/archived) live in meta.json and land
    // like any content; this doc carries:
    //   state: 'orphaned'|''   set/cleared by admins (guides join in later) —
    //                          the "seeking maintainer" banner
    //   successor: {uid,name}  the maintainer's designated successor (right of
    //                          first refusal when the map orphans)
    // Public read: succession and orphanhood are governance facts, not secrets.
    match /mapstates/{rm} {
      allow read: if true;
      allow create, update: if
        ( isAdmin()
          && request.resource.data.keys().hasOnly(['state','note','by','at','successor','guild'])
          && (!('state' in request.resource.data)
              || request.resource.data.state in ['orphaned',''])
          && (!('note' in request.resource.data)
              || (request.resource.data.note is string
                  && request.resource.data.note.size() <= 300)) )
        // a guild's guide may flag/clear orphanhood for maps in their guild —
        // the write names the guild, and the map must belong to it
        || ( 'guild' in request.resource.data
          && request.resource.data.guild is string
          && guideOf(request.resource.data.guild)
          && rm in get(/databases/$(db)/documents/guilds/$(request.resource.data.guild)).data.maps
          && request.resource.data.diff(resource == null ? {} : resource.data)
               .affectedKeys().hasOnly(['state','note','by','at','guild'])
          && request.resource.data.state in ['orphaned','']
          && (!('note' in request.resource.data)
              || (request.resource.data.note is string
                  && request.resource.data.note.size() <= 300)) )
        || ( maintains(rm)
          && request.resource.data.diff(resource == null ? {} : resource.data)
               .affectedKeys().hasOnly(['successor'])
          && request.resource.data.successor is map
          && request.resource.data.successor.keys().hasOnly(['uid','name'])
          && request.resource.data.successor.uid is string
          && request.resource.data.successor.uid.size() <= 128
          && request.resource.data.successor.name is string
          && request.resource.data.successor.name.size() <= 80 );
      allow delete: if isAdmin();
    }

    // Guilds: the community around a subject area — a grouping of maps, a
    // talk space, and the pool future maintainers grow from. Social structure,
    // not authority: guilds advise maintainers, never overrule them.
    match /guilds/{gid} {
      allow read: if true;
      allow create, update: if isAdmin()
        && gid.matches('[a-z0-9-]{1,50}')
        && request.resource.data.keys().hasOnly(
             ['title','blurb','maps','guides','createdAt','updatedAt'])
        && request.resource.data.title is string
        && request.resource.data.title.size() >= 3
        && request.resource.data.title.size() <= 60
        && request.resource.data.blurb is string
        && request.resource.data.blurb.size() <= 300
        && request.resource.data.maps is list
        && request.resource.data.maps.size() <= 50
        && request.resource.data.guides is map
        && request.resource.data.guides.size() <= 10;
      allow delete: if isAdmin();

      // Guild talk: the shared space. Same contract as proposal comments —
      // signed-in, immutable, moderated by this guild's guides (and admins).
      match /talk/{tid} {
        allow read: if true;
        allow create: if signedIn()
          && request.resource.data.keys().hasOnly(['text','by','createdAt'])
          && request.resource.data.by.uid == request.auth.uid
          && request.resource.data.by.name is string
          && request.resource.data.by.name.size() <= 80
          && request.resource.data.text is string
          && request.resource.data.text.size() >= 1
          && request.resource.data.text.size() <= 2000
          && request.resource.data.createdAt == request.time;
        allow update: if false;
        allow delete: if isAdmin() || guideOf(gid);
      }
    }

    // Endorsement: a guild's quality mark — one map per subject per audience,
    // on published criteria, signed and dated. The ONLY place comparative
    // judgment between maps enters the system. `method` is locked to 'guide'
    // until elections exist (the field is vote-ready). Re-endorse = delete +
    // create; no edits, so the mark's history stays honest.
    match /endorsements/{id} {
      allow read: if true;
      allow create: if
        request.resource.data.keys().hasOnly(
          ['guild','roadmap','audience','criteria','method','by','at'])
        && request.resource.data.guild is string
        && (isAdmin() || guideOf(request.resource.data.guild))
        && request.resource.data.roadmap in
             get(/databases/$(db)/documents/guilds/$(request.resource.data.guild)).data.maps
        && request.resource.data.audience is string
        && request.resource.data.audience.size() >= 1
        && request.resource.data.audience.size() <= 40
        && request.resource.data.criteria is string
        && request.resource.data.criteria.size() >= 20
        && request.resource.data.criteria.size() <= 1000
        && request.resource.data.method == 'guide'
        && request.resource.data.by.uid == request.auth.uid
        && request.resource.data.at == request.time;
      allow update: if false;
      allow delete: if isAdmin() || guideOf(resource.data.guild);
    }

    // Steward bindings, one doc per map: {members: {uid: displayName}}.
    // Public read (authority is named, always); written only by that map's
    // moderators. Member-name lengths can't be iterated by the rules language
    // (same accepted caveat as fork ops); the client esc()s on render.
    match /stewards/{rm} {
      allow read: if true;
      allow write: if moderates(rm)
        && request.resource.data.keys().hasOnly(['members','updatedAt'])
        && request.resource.data.members is map
        && request.resource.data.members.size() <= 10;
    }

    // Approved community tips, shown under nodes. Public read.
    // Shape is {nodeId: [tip, …]} — map values can't be iterated by the rules
    // language, so per-tip validation is impossible here (accepted caveat,
    // same class as fork ops); the doc-wide size cap bounds the blast radius
    // and the client esc()s on render.
    match /tips/{rm} {
      allow read: if true;
      allow write: if moderates(rm)
        && request.resource.data.size() <= 300;
    }

    // Affiliation disclosure (Part V): every contribution says whether its
    // author has a relationship with the resource. Undisclosed affiliation
    // discovered later is a conduct violation (GOVERNANCE). Absent fields =
    // docs that predate disclosure; clients render them as such.
    function disclosureOk(d) {
      return (!('affiliated' in d) && !('affiliation' in d))
        || ( d.affiliated is bool
          && d.affiliation is string
          && d.affiliation.size() <= 300
          && (d.affiliated || d.affiliation == '') );
    }
    match /suggestions/{id} {
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(
             ['roadmap','node','nodeTitle','type','text','url','verified','by',
              'createdAt','status','affiliated','affiliation'])
        && request.resource.data.by.uid == request.auth.uid
        && notAgentIdentity(request.resource.data)
        && request.resource.data.status == 'pending'
        && request.resource.data.type in ['fix','link','tip','topic','roadmap','adopt']
        && disclosureOk(request.resource.data)
        && request.resource.data.text is string
        && request.resource.data.text.size() >= 20
        && request.resource.data.text.size() <= 4000
        && request.resource.data.url is string
        && request.resource.data.url.size() <= 500
        && (request.resource.data.url == '' || request.resource.data.url.matches('https://.*'))
        // cheap affiliate tripwire — build.py is the real authority at landing
        && !request.resource.data.url.matches('.*[?&](utm_[a-zA-Z]+|fbclid|gclid)=.*')
        && request.resource.data.roadmap is string
        && request.resource.data.roadmap.size() <= 50
        && request.resource.data.node is string
        && request.resource.data.node.size() <= 80
        && request.resource.data.nodeTitle.size() <= 120
        && request.resource.data.createdAt == request.time;
      // authors can always see their own contribution and its outcome —
      // the feedback loop is what keeps contributors (GOVERNANCE: review
      // latency kills a commons). `reason` rides along on decisions so a
      // rejection can name the charter rule it hit.
      allow read: if isAdmin() || maintains(resource.data.roadmap)
        || (signedIn() && resource.data.by.uid == request.auth.uid);
      allow update: if moderates(resource.data.roadmap)
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['status','decidedAt','decidedBy','reason'])
        && request.resource.data.status in ['published','accepted','rejected'];
      allow delete: if isAdmin()
        || (signedIn() && resource.data.by.uid == request.auth.uid
            && resource.data.status == 'pending');
    }

    match /proposals/{id} {
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(
             ['roadmap','kind','file','file2','baseHash','baseHash2','topic','topic2',
              'after','spine','about','note','by','createdAt','status','weight',
              'affiliated','affiliation','branch','ownerUid'])
        && request.resource.data.by.uid == request.auth.uid
        && notAgentIdentity(request.resource.data)
        && request.resource.data.status == 'pending'
        // Branch proposals (Stage 5, owner-opt-in): `branch` names the target
        // fork/usermap, `ownerUid` denormalizes its owner (the decider — one
        // query serves the owner's queue). Both are verified against the live
        // target doc, and the door only opens when its owner set
        // suggestions:true. For branch proposals `roadmap` is display text;
        // for library proposals it stays the strict category id.
        && ( !('branch' in request.resource.data)
             ? request.resource.data.roadmap.matches('[a-z0-9-]{1,50}')
             : ( request.resource.data.roadmap is string
                 && request.resource.data.roadmap.size() >= 1
                 && request.resource.data.roadmap.size() <= 80
                 && request.resource.data.branch.keys().hasOnly(['kind','id'])
                 && request.resource.data.branch.id is string
                 && request.resource.data.branch.id.size() <= 128
                 && request.resource.data.ownerUid is string
                 && ( ( request.resource.data.branch.kind == 'fork'
                        && get(/databases/$(db)/documents/forks/$(request.resource.data.branch.id))
                             .data.suggestions == true
                        && get(/databases/$(db)/documents/forks/$(request.resource.data.branch.id))
                             .data.owner.uid == request.resource.data.ownerUid )
                   || ( request.resource.data.branch.kind == 'umap'
                        && get(/databases/$(db)/documents/usermaps/$(request.resource.data.branch.id))
                             .data.suggestions == true
                        && get(/databases/$(db)/documents/usermaps/$(request.resource.data.branch.id))
                             .data.owner.uid == request.resource.data.ownerUid ) ) ) )
        && validStructOp(request.resource.data)
        && (!('weight' in request.resource.data)
            || request.resource.data.weight in ['trivial','substantive'])
        && disclosureOk(request.resource.data)
        && request.resource.data.note is string
        && request.resource.data.note.size() <= 1000
        && request.resource.data.createdAt == request.time;
      // Proposals are public — the open comment period (below) needs readable
      // proposals, and the change was always destined for the public record.
      allow read: if true;
      // Decision authority by weight class:
      //   trivial edit        → steward of the map, or any moderator
      //   substantive edit    → moderator only
      //   structural kinds    → moderator only, and MERGE must wait out the
      //                         7-day open comment period (reject anytime —
      //                         a fast no beats a slow one).
      // A maintainer's own direct edit (no proposal doc) stays immediate:
      // final say inside their map is the deal.
      allow update: if request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['status','decidedAt','decidedBy','reason'])
        && request.resource.data.status in ['merged','rejected']
        // A branch proposal is the branch owner's to decide, alone — full
        // authority on their own surface, no weight classes, no comment
        // clock (those guard the shared trunk, not a personal branch).
        && ( 'branch' in resource.data
             ? (signedIn() && request.auth.uid == resource.data.ownerUid)
             : ( ( moderates(resource.data.roadmap)
                 || (stewardOf(resource.data.roadmap) && trivialEdit(resource.data)) )
               && ( request.resource.data.status != 'merged'
                 || !structuralKind(resource.data)
                 || request.time > resource.data.createdAt + duration.value(7, 'd') ) ) );
      allow delete: if isAdmin()
        || (signedIn() && resource.data.by.uid == request.auth.uid
            && resource.data.status == 'pending');

      // Open discussion on a proposal — the talk-space starter. Signed-in
      // create, immutable once posted, removable by the map's moderators.
      match /comments/{cid} {
        allow read: if true;
        allow create: if signedIn()
          && request.resource.data.keys().hasOnly(['text','by','createdAt'])
          && request.resource.data.by.uid == request.auth.uid
          && request.resource.data.by.name is string
          && request.resource.data.by.name.size() <= 80
          && request.resource.data.text is string
          && request.resource.data.text.size() >= 1
          && request.resource.data.text.size() <= 2000
          && request.resource.data.createdAt == request.time;
        allow update: if false;
        allow delete: if isAdmin()
          || maintains(get(/databases/$(db)/documents/proposals/$(id)).data.roadmap);
      }
    }

    // Merged edits: the live content overlay (public read) AND the landing
    // queue for the GitHub Action. The Action uses the Admin SDK (bypasses
    // rules) to stamp committedSha / clean up.
    match /merged/{id} {
      allow read: if true;
      // Moderators create overlay docs freely. A steward's path is narrower:
      // the merged doc must name its proposal, and that proposal must be a
      // trivial edit on the steward's own map — the overlay write and the
      // decision ride the same batch, so the cross-doc get() sees the
      // pre-batch (still-pending) proposal.
      allow create: if request.resource.data.mergedBy.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(
             ['roadmap','kind','file','file2','topic','topic2','after','spine',
              'about','by','mergedBy','note','at','proposal','weight'])
        // attribution is required — tools/land.mjs writes both names into the
        // public commit message and must never meet a doc without them
        && request.resource.data.by is map
        && request.resource.data.by.uid is string
        && request.resource.data.by.name is string
        && request.resource.data.by.name.size() <= 80
        && request.resource.data.mergedBy.name is string
        && request.resource.data.mergedBy.name.size() <= 80
        && request.resource.data.roadmap.matches('[a-z0-9-]{1,50}')
        && validStructOp(request.resource.data)
        && ( moderates(request.resource.data.roadmap)
          || ( stewardOf(request.resource.data.roadmap)
            && 'proposal' in request.resource.data
            && request.resource.data.proposal is string
            && trivialEdit(get(/databases/$(db)/documents/proposals/$(request.resource.data.proposal)).data)
            && get(/databases/$(db)/documents/proposals/$(request.resource.data.proposal)).data.roadmap
                 == request.resource.data.roadmap ) );
      allow update, delete: if false;
    }

    // Collections: owner-curated shelves of existing maps (GOVERNANCE.md's
    // "fork valve"). Pointers, not content — they can't touch topic files, so
    // no review pipeline: the owner IS the filter. Admins moderate with
    // exactly two switches (featured / hidden). `maps` entries can't be
    // iterated by the rules language; the client renders only ids it finds in
    // the index, so junk entries are inert.
    function validCollection(d) {
      return d.keys().hasOnly(['title','blurb','maps','owner',
                               'featured','hidden','createdAt','updatedAt'])
        && d.title is string && d.title.size() >= 3 && d.title.size() <= 60
        && d.blurb is string && d.blurb.size() <= 300
        && d.maps is list && d.maps.size() >= 1 && d.maps.size() <= 30
        && d.owner is map
        && d.owner.uid is string && d.owner.uid.size() <= 128
        && d.owner.name is string && d.owner.name.size() <= 80
        && d.featured is bool && d.hidden is bool;
    }
    // Personal versions ("Personalize"): a fork is NOT a copy — it's the base
    // map's id plus a saved list of structural ops, rendered client-side over
    // the live base by the same applyMergedDocs used for the merged overlay.
    // Untouched topics therefore track the canonical map automatically; only
    // op-covered topics diverge. Ops can't be iterated by the rules language
    // (same caveat as collection `maps` / spine entries): the client validates
    // and escapes on render, and forks never reach the repo pipeline, so a
    // malformed op can only garble its own fork. Admin moderation = `hidden`.
    function validFork(d) {
      return d.keys().hasOnly(['base','title','subtitle','about','ops','owner',
                               'hidden','public','suggestions',
                               'createdAt','updatedAt'])
        && d.base is string && d.base.matches('[a-z0-9-]{1,50}')
        && d.title is string && d.title.size() >= 3 && d.title.size() <= 80
        // subtitle: the branch's one-line self-description ("beginner
        // version") shown on the picker row — optional, owner's words
        && (!('subtitle' in d) || (d.subtitle is string && d.subtitle.size() <= 90))
        // about: the branch's intro prose, mirroring the official map's lead
        && (!('about' in d) || (d.about is string && d.about.size() <= 4000))
        && d.ops is list && d.ops.size() <= 100
        && d.owner is map
        && d.owner.uid is string && d.owner.uid.size() <= 128
        && d.owner.name is string && d.owner.name.size() <= 80
        // public: listed on the category page. Branches are BORN UNLISTED —
        // creation forces false; listing is the owner's deliberate act.
        // (Optional so pre-field docs stay editable; absent reads as false.)
        && (!('public' in d) || d.public is bool)
        // suggestions: owner-opt-in door for proposals against this branch
        // (absent reads as closed — brigading stays off by default)
        && (!('suggestions' in d) || d.suggestions is bool)
        && d.hidden is bool;
    }
    match /forks/{id} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.owner.uid == request.auth.uid
        && validFork(request.resource.data)
        && request.resource.data.hidden == false
        && request.resource.data.public == false
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow update: if (signedIn()
          && resource.data.owner.uid == request.auth.uid
          && validFork(request.resource.data)
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['title','subtitle','about','ops','public',
                         'suggestions','updatedAt']))
        || (isAdmin()
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['hidden']));
      allow delete: if isAdmin()
        || (signedIn() && resource.data.owner.uid == request.auth.uid);
    }

    // Personal maps: from-scratch maps below the commons. Unlike a fork
    // (ops over a living base) a personal map carries its full topic list
    // directly — there is no base to track. They live only in Firestore,
    // never the repo, and are absent from every library surface: the link
    // is the door. Deep per-node validation is not expressible in rules
    // (the forks stance): the client escapes on render, and a malformed
    // topic can only garble its own map. The 1 MiB doc limit is the
    // natural total cap. Admin moderation = `hidden`, exactly like forks.
    function validUserMap(d) {
      return d.keys().hasOnly(['title','emoji','tagline','about','topics',
                               'owner','lineage','slug','listed','suggestions',
                               'hidden','createdAt','updatedAt'])
        && d.title is string && d.title.size() >= 3 && d.title.size() <= 80
        && d.emoji is string && d.emoji.size() >= 1 && d.emoji.size() <= 8
        && (!('tagline' in d) || (d.tagline is string && d.tagline.size() <= 140))
        && (!('about' in d) || (d.about is string && d.about.size() <= 4000))
        && d.topics is list && d.topics.size() >= 1 && d.topics.size() <= 40
        && d.owner is map
        && d.owner.uid is string && d.owner.uid.size() <= 128
        && d.owner.name is string && d.owner.name.size() <= 80
        // lineage: attribution for a branched copy — plain strings stamped at
        // create (never owner-updatable), so a deleted source breaks nothing
        && (!('lineage' in d) || (d.lineage is map
            && d.lineage.keys().hasOnly(['from','title','owner'])
            && d.lineage.from is string && d.lineage.from.size() <= 128
            && d.lineage.title is string && d.lineage.title.size() <= 80
            && d.lineage.owner is string && d.lineage.owner.size() <= 80))
        // slug + listed: the creator-page shelf (#/@handle) — the owner's own
        // surface, never the library's. Born unlisted, same as branches.
        && (!('slug' in d) || (d.slug is string && d.slug.matches('[a-z0-9-]{1,60}')))
        && (!('listed' in d) || d.listed is bool)
        // suggestions: owner-opt-in door for proposals (absent = closed)
        && (!('suggestions' in d) || d.suggestions is bool)
        && d.hidden is bool;
    }
    match /usermaps/{id} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.owner.uid == request.auth.uid
        && validUserMap(request.resource.data)
        && request.resource.data.hidden == false
        && request.resource.data.get('listed', false) == false
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow update: if (signedIn()
          && resource.data.owner.uid == request.auth.uid
          && validUserMap(request.resource.data)
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['title','emoji','tagline','about','topics',
                         'slug','listed','suggestions','updatedAt']))
        || (isAdmin()
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['hidden']));
      allow delete: if isAdmin()
        || (signedIn() && resource.data.owner.uid == request.auth.uid);
    }

    // Handles: first-come claims on a public name (#/@handle). One doc per
    // handle, id = the handle itself; create-only-if-absent IS the claim
    // semantics (Firestore create fails on an existing doc). No squatting
    // protection beyond first-come at v1 (plan Stage 4). Release = delete.
    match /handles/{h} {
      allow read: if true;
      allow create: if signedIn()
        && h.matches('[a-z0-9-]{3,30}')
        && request.resource.data.keys().hasOnly(['uid','name','createdAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 1
        && request.resource.data.name.size() <= 80
        && request.resource.data.createdAt == request.time;
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
      // A handle is claimed or released, never re-pointed — but its holder
      // may refresh the public name it carries (display-name changes) and
      // keep an optional contact line. uid and createdAt stay immutable.
      allow update: if signedIn() && resource.data.uid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['name','contact'])
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 1
        && request.resource.data.name.size() <= 80
        && request.resource.data.get('contact', '') is string
        && request.resource.data.get('contact', '').size() <= 200;
    }

    // Reports: the community's flag on public content — user-generated
    // surfaces (tips, collections, personal versions) AND, since the safety
    // queue landed, canonical map content (kind 'map', target {roadmap, node?,
    // resource?}). severity 'safety' is the red-flag queue: dangerous
    // instructions, medical misinformation — 48-hour response norm.
    // A report is a message to the moderators, not public speech: users
    // Admins see everything; a map's maintainer sees and resolves reports
    // about their own map's content; the REPORTER sees their own report —
    // and with it the resolution note — on their account page. Nobody else
    // reads a report: they may name people and unlisted things.
    match /reports/{id} {
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(
             ['kind','target','text','severity','status','by','createdAt'])
        && request.resource.data.kind in ['tip','collection','fork','usermap','map']
        && request.resource.data.target is map
        && request.resource.data.severity in ['normal','safety']
        && request.resource.data.status == 'open'
        && request.resource.data.text is string
        && request.resource.data.text.size() >= 5
        && request.resource.data.text.size() <= 500
        && request.resource.data.by.uid == request.auth.uid
        && request.resource.data.createdAt == request.time;
      allow read: if isAdmin()
        || (signedIn() && resource.data.by.uid == request.auth.uid)
        || (resource.data.kind == 'map'
            && resource.data.target.roadmap is string
            && maintains(resource.data.target.roadmap));
      allow update: if (isAdmin()
          || (resource.data.kind == 'map'
              && resource.data.target.roadmap is string
              && maintains(resource.data.target.roadmap)))
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['status','resolvedAt','resolvedBy','resolution'])
        && request.resource.data.status in ['resolved','dismissed']
        && request.resource.data.get('resolution', '') is string
        && request.resource.data.get('resolution', '').size() <= 500;
      allow delete: if isAdmin();
    }

    // Resource flags: the walker's one-tap "link dead / stale / didn't help".
    // The doc id IS the abuse cap — `${uid}_${key}` makes each user's flag on
    // each resource a single idempotent write (no rate-limit machinery needed).
    // Moderator-scoped read (flag ids embed uids — not public speech);
    // clearing the flags on a fixed resource = moderator delete.
    match /flags/{flagId} {
      allow create: if signedIn()
        && flagId == request.auth.uid + '_' + request.resource.data.key
        && request.resource.data.keys().hasOnly(
             ['key','roadmap','node','url','reason','by','createdAt'])
        && request.resource.data.by == request.auth.uid
        && request.resource.data.key is string
        && request.resource.data.key.size() <= 200
        && request.resource.data.roadmap.matches('[a-z0-9-]{1,50}')
        && request.resource.data.node is string
        && request.resource.data.node.size() <= 80
        && request.resource.data.url is string
        && request.resource.data.url.size() <= 500
        && request.resource.data.url.matches('https://.*')
        && request.resource.data.reason in ['dead','stale','unhelpful']
        && request.resource.data.createdAt == request.time;
      allow read, delete: if isAdmin() || maintains(resource.data.roadmap);
      allow update: if false;
    }

    match /collections/{id} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.owner.uid == request.auth.uid
        && validCollection(request.resource.data)
        && request.resource.data.featured == false
        && request.resource.data.hidden == false
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow update: if (signedIn()
          && resource.data.owner.uid == request.auth.uid
          && validCollection(request.resource.data)
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['title','blurb','maps','updatedAt']))
        || (isAdmin()
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['featured','hidden']));
      allow delete: if isAdmin()
        || (signedIn() && resource.data.owner.uid == request.auth.uid);
    }
  }
}
