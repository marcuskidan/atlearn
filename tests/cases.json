{
 "comment": "Data-driven cases for the client's pure logic, consumed by tests/client.test.mjs. expect paths are <roadmap>.<node>.<field> resolved against result.progress.",
 "mergeStores": [
  {
   "name": "disjoint roadmaps union",
   "a": {
    "v": 1,
    "progress": {
     "astro": {
      "n1": {
       "status": 2,
       "notes": "",
       "done": [
        true
       ],
       "updatedAt": 100
      }
     }
    }
   },
   "b": {
    "v": 1,
    "progress": {
     "cook": {
      "n2": {
       "status": 1,
       "notes": "x",
       "done": [],
       "updatedAt": 50
      }
     }
    }
   },
   "expect": {
    "astro.n1.status": 2,
    "cook.n2.status": 1
   }
  },
  {
   "name": "newer record wins (LWW)",
   "a": {
    "v": 1,
    "progress": {
     "astro": {
      "n1": {
       "status": 1,
       "notes": "old",
       "done": [],
       "updatedAt": 100
      }
     }
    }
   },
   "b": {
    "v": 1,
    "progress": {
     "astro": {
      "n1": {
       "status": 2,
       "notes": "new",
       "done": [],
       "updatedAt": 200
      }
     }
    }
   },
   "expect": {
    "astro.n1.status": 2,
    "astro.n1.notes": "new"
   }
  },
  {
   "name": "timestamp tie favors first argument (>=)",
   "a": {
    "v": 1,
    "progress": {
     "astro": {
      "n1": {
       "status": 1,
       "notes": "a",
       "done": [],
       "updatedAt": 100
      }
     }
    }
   },
   "b": {
    "v": 1,
    "progress": {
     "astro": {
      "n1": {
       "status": 2,
       "notes": "b",
       "done": [],
       "updatedAt": 100
      }
     }
    }
   },
   "expect": {
    "astro.n1.notes": "a"
   }
  },
  {
   "name": "missing updatedAt loses to any timestamp",
   "a": {
    "v": 1,
    "progress": {
     "astro": {
      "n1": {
       "status": 1,
       "notes": "untimed",
       "done": []
      }
     }
    }
   },
   "b": {
    "v": 1,
    "progress": {
     "astro": {
      "n1": {
       "status": 2,
       "notes": "timed",
       "done": [],
       "updatedAt": 5
      }
     }
    }
   },
   "expect": {
    "astro.n1.notes": "timed"
   }
  },
  {
   "name": "one-sided records survive",
   "a": {
    "v": 1,
    "progress": {}
   },
   "b": {
    "v": 1,
    "progress": {
     "astro": {
      "n1": {
       "status": 1,
       "notes": "solo",
       "done": [],
       "updatedAt": 1
      }
     }
    }
   },
   "expect": {
    "astro.n1.notes": "solo"
   }
  },
  {
   "name": "unversioned v0 inputs migrate and merge",
   "a": {
    "progress": {
     "astro": {
      "n1": {
       "status": 2,
       "notes": "v0a",
       "done": [],
       "updatedAt": 300
      }
     }
    }
   },
   "b": {
    "progress": {
     "astro": {
      "n1": {
       "status": 1,
       "notes": "v0b",
       "done": [],
       "updatedAt": 100
      }
     }
    }
   },
   "expect": {
    "astro.n1.notes": "v0a"
   }
  },
  {
   "name": "journal newer entry wins per id",
   "a": {
    "v": 2,
    "progress": {},
    "journal": {
     "e1": {
      "text": "old",
      "updatedAt": 10
     },
     "e2": {
      "text": "only-a",
      "updatedAt": 1
     }
    }
   },
   "b": {
    "v": 2,
    "progress": {},
    "journal": {
     "e1": {
      "text": "new",
      "updatedAt": 20
     }
    }
   },
   "expect": {},
   "expectRoot": {
    "journal.e1.text": "new",
    "journal.e2.text": "only-a"
   }
  },
  {
   "name": "journal tombstone beats older live entry",
   "a": {
    "v": 2,
    "progress": {},
    "journal": {
     "e1": {
      "text": "alive",
      "updatedAt": 10
     }
    }
   },
   "b": {
    "v": 2,
    "progress": {},
    "journal": {
     "e1": {
      "text": "",
      "deleted": true,
      "updatedAt": 30
     }
    }
   },
   "expect": {},
   "expectRoot": {
    "journal.e1.deleted": true
   }
  },
  {
   "name": "one-sided journal survives merge with journal-less v1 store",
   "a": {
    "v": 1,
    "progress": {}
   },
   "b": {
    "v": 2,
    "progress": {},
    "journal": {
     "e1": {
      "text": "kept",
      "updatedAt": 2
     }
    }
   },
   "expect": {},
   "expectRoot": {
    "journal.e1.text": "kept"
   }
  },
  {
   "name": "seen and settings carried LWW",
   "a": {
    "v": 2,
    "progress": {},
    "seen": {
     "astro": {
      "version": "1.0.0",
      "at": 10
     }
    },
    "settings": {
     "streaks": false,
     "updatedAt": 1
    }
   },
   "b": {
    "v": 2,
    "progress": {},
    "seen": {
     "astro": {
      "version": "1.1.0",
      "at": 20
     }
    },
    "settings": {
     "streaks": true,
     "updatedAt": 9
    }
   },
   "expect": {},
   "expectRoot": {
    "seen.astro.version": "1.1.0",
    "settings.streaks": true
   }
  }
 ],
 "contentHash": [
  {
   "name": "identical objects hash identically",
   "input": {
    "id": "x",
    "title": "T",
    "learn": {
     "summary": "s"
    }
   },
   "same": {
    "id": "x",
    "title": "T",
    "learn": {
     "summary": "s"
    }
   }
  },
  {
   "name": "content change changes the hash",
   "input": {
    "id": "x",
    "title": "T"
   },
   "different": {
    "id": "x",
    "title": "T2"
   }
  },
  {
   "name": "key order changes the hash (stringify-order sensitivity is intended)",
   "input": {
    "a": 1,
    "b": 2
   },
   "different": {
    "b": 2,
    "a": 1
   }
  }
 ],
 "migrateStore": [
  {
   "name": "null becomes empty v2",
   "input": null,
   "expectV": 2,
   "expectEmpty": true
  },
  {
   "name": "v0 blob wraps to v2 preserving progress",
   "input": {
    "progress": {
     "astro": {
      "n1": {
       "status": 2,
       "notes": "keep",
       "done": [],
       "updatedAt": 9
      }
     }
    }
   },
   "expectV": 2,
   "expectPath": "astro.n1.notes",
   "expectValue": "keep"
  },
  {
   "name": "v1 upgrades to v2 preserving progress",
   "input": {
    "v": 1,
    "progress": {
     "astro": {
      "n1": {
       "status": 1,
       "notes": "asis",
       "done": [],
       "updatedAt": 2
      }
     }
    }
   },
   "expectV": 2,
   "expectPath": "astro.n1.notes",
   "expectValue": "asis"
  },
  {
   "name": "v1 upgrade adds empty journal/settings/seen",
   "input": {
    "v": 1,
    "progress": {}
   },
   "expectV": 2,
   "expectRoot": {
    "journal": {},
    "settings": {},
    "seen": {}
   }
  },
  {
   "name": "v2 passes through untouched",
   "input": {
    "v": 2,
    "progress": {},
    "journal": {
     "e1": {
      "text": "kept",
      "updatedAt": 5
     }
    },
    "settings": {
     "streaks": true,
     "updatedAt": 1
    },
    "seen": {
     "astro": {
      "version": "1.0.0",
      "at": 3
     }
    }
   },
   "expectV": 2,
   "expectRoot": {
    "journal.e1.text": "kept",
    "settings.streaks": true,
    "seen.astro.version": "1.0.0"
   }
  }
 ]
}